\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Matriks keputusan voting per-sensor. Panel atas: suhu ($>80^\circ $C). Panel tengah: tekanan ($<900$ atau $>1200$ hPa). Panel bawah: vibrasi ($>500$). Terlihat bahwa tekanan tetap normal sepanjang simulasi, sehingga fault hanya dideklarasikan ketika suhu \textit  {dan} vibrasi melewati threshold secara bersamaan (2 dari 3 sensor).}}{18}{figure.caption.13}\protected@file@percent }
\newlabel{fig:voting}{{6}{18}{Matriks keputusan voting per-sensor. Panel atas: suhu ($>80^\circ $C). Panel tengah: tekanan ($<900$ atau $>1200$ hPa). Panel bawah: vibrasi ($>500$). Terlihat bahwa tekanan tetap normal sepanjang simulasi, sehingga fault hanya dideklarasikan ketika suhu \textit {dan} vibrasi melewati threshold secara bersamaan (2 dari 3 sensor)}{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Perbandingan metode kami terhadap tiga referensi kunci (J14, J17, J21) pada enam dimensi: memory safety, concurrency model, sensor fusion, fail-safe mechanism, latency precision, dan dokumentasi. Metode kami unggul di seluruh dimensi.}}{19}{figure.caption.14}\protected@file@percent }
\newlabel{fig:comparison}{{7}{19}{Perbandingan metode kami terhadap tiga referensi kunci (J14, J17, J21) pada enam dimensi: memory safety, concurrency model, sensor fusion, fail-safe mechanism, latency precision, dan dokumentasi. Metode kami unggul di seluruh dimensi}{figure.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Analisis latensi deteksi fault. Latensi terukur 15~$\mu $s (garis hijau) berada di atas safety threshold 5~$\mu $s (garis merah). Perbedaan ini disebabkan oleh overhead interpreter MicroPython pada simulasi Proteus; implementasi Rust bare-metal pada hardware fisik diprediksikan mencapai $<5$~$\mu $s berdasarkan resolusi TIMG0 (12.5 ns/tick).}}{19}{figure.caption.15}\protected@file@percent }
\newlabel{fig:latency}{{8}{19}{Analisis latensi deteksi fault. Latensi terukur 15~$\mu $s (garis hijau) berada di atas safety threshold 5~$\mu $s (garis merah). Perbedaan ini disebabkan oleh overhead interpreter MicroPython pada simulasi Proteus; implementasi Rust bare-metal pada hardware fisik diprediksikan mencapai $<5$~$\mu $s berdasarkan resolusi TIMG0 (12.5 ns/tick)}{figure.caption.15}{}}
